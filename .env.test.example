# Copy privately to .env.test; never commit credentials or reuse production state.
# Fill exact source SHA from artifact.json (40 lowercase hex characters).
DRINK_POS_TEST_IMAGE=drink-pos-test:REPLACE_WITH_EXACT_SHA
DRINK_POS_TEST_HOST_ROOT=/volume1/docker/drink-pos-test
# NAS CLI: id TEST_OPERATOR (do not guess IDs or use production service account)
DRINK_POS_TEST_UID=REPLACE_WITH_TEST_OWNER_UID
DRINK_POS_TEST_GID=REPLACE_WITH_TEST_OWNER_GID
DRINK_POS_TEST_ID=drink-pos-test-ds224
DRINK_POS_TEST_PIN=REPLACE_WITH_RANDOM_TEST_ONLY_PIN
DRINK_POS_TEST_TZ=Europe/Zurich
# Verify these do not overlap NAS/LAN/VPN/other Docker networks before use.
# No host port publishing: DSM reverse proxy -> container IP:8000.
DRINK_POS_TEST_SUBNET=172.30.89.0/28
DRINK_POS_TEST_CONTAINER_IP=172.30.89.2
DRINK_POS_TEST_STATE=data
