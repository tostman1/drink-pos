{
  "id": "/kassa",
  "name": "Drink POS Kassa",
  "short_name": "Kassa",
  "start_url": "/kassa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#f5f7fb",
